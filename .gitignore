*.pem
*.key

# deployment
.vercel

# editors and OS (team-wide editor settings can be opted back in)
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Claude Code: personal settings only; .claude/settings.json is shared
.claude/settings.local.json
