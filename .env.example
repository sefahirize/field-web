# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle: nothing secret here.

# Public origin of this app, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Landing ---------------------------------------------------------------
# reCAPTCHA v3 for the contact form. The site key is public, the secret is not.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mailchimp (server only). The data-center suffix of the key ("-us18") is used
# when MAILCHIMP_SERVER is empty.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=

# Optional overrides; the code has defaults.
# NEXT_PUBLIC_WORDPRESS_REST_API_BASE=https://blog.hirize.ai/wp-json/wp/v2
# NEXT_PUBLIC_APP_URL=

# --- Dashboard ---------------------------------------------------------------
# Optional; the defaults below are what the app uses when these are empty.
# Backend the /api/v1 and /uploads rewrites forward to (server side only).
# DASHBOARD_API_ORIGIN=http://api.joinfield.ai
# Base URL axios calls. Keep the relative default until the API has HTTPS and CORS.
# NEXT_PUBLIC_API_BASE_URL=/api/v1/
# "true" signs in against an in-memory mock (any email, password "password").
# Development only: production builds ignore it.
# NEXT_PUBLIC_USE_MOCK_AUTH=false
# "false" hides the API test tools in the dashboard.
# NEXT_PUBLIC_TEST_TOOLS=true
